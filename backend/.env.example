NODE_ENV=development
PORT=3001
# Legacy SQL backend only: supply DATABASE_URL privately if maintaining unmigrated workflows.
# The default application setup uses cloud-backend/ and DynamoDB.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
INVITE_TOKEN_EXPIRES_HOURS=168
FRONTEND_URL=http://localhost:5174
EXTERNAL_FRONTEND_URL=http://localhost:5174
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Peoples Management
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
